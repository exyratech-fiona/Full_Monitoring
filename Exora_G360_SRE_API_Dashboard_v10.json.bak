      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",http_request_method=~\"$http_method\",http_route=~\"$http_operation\"}[$__rate_interval])))",
