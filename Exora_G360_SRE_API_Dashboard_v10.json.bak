          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",http_request_method=~\"$http_method\",http_route=~\"$http_operation\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P95",
          "exemplar": true,
          "interval": "10m"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",http_request_method=~\"$http_method\",http_route=~\"$http_operation\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P99",
          "exemplar": true,
          "interval": "10m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "showPoints": "never",
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 303,
      "title": "Selected endpoint — latency distribution (heatmap)",
      "description": "Renders the raw histogram buckets. Bi-modal bands here mean the endpoint has two distinct code paths (e.g. cache hit vs DB round-trip) — pick a slow request from the trace list below to see which.",
      "type": "heatmap",
      "gridPos": {
        "x": 16,
        "y": 32,
        "w": 8,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (le) (rate(http_server_request_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",http_request_method=~\"$http_method\",http_route=~\"$http_operation\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "exemplar": true,
          "interval": "2m"
        }
      ],
      "options": {
        "calculate": false,
        "cellGap": 1,
        "color": {
          "mode": "scheme",
          "scheme": "Turbo",
          "steps": 64,
          "reverse": false,
          "exponent": 0.5,
          "fill": "dark-orange"
        },
        "yAxis": {
          "unit": "s",
          "axisPlacement": "left"
        },
        "tooltip": {
          "show": true,
          "yHistogram": false
        },
        "legend": {
          "show": true
        },
        "exemplars": {
          "color": "rgba(255,0,255,0.7)"
        },
        "filterValues": {
          "le": 1e-9
        },
        "rowsFrame": {
          "layout": "auto"
        }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "hideFrom": {
              "tooltip": false,
              "viz": false,
              "legend": false
            }
          }
        },
        "overrides": []
      }
    },
    {
      "id": 400,
      "type": "row",
      "title": "REQUEST JOURNEY — INDIVIDUAL REQUESTS (TEMPO)",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 401,
      "title": "API REQUESTS — click any row to load its waterfall below",
      "description": "TEMPO / TraceQL, tableType = spans. kind=server keeps background jobs (OutboxRelay.relay) out of the list; select() supplies the method / route / status / pod columns.\n\nCLICK THE 'Trace ID' COLUMN — that cell carries the drilldown link. It rewrites the dashboard URL with var-traceID, which the waterfall panel and the Loki panel below both read. Clicking any other column does nothing.\n\nGrafana cannot expand a waterfall inside a table panel; a table row -> data link -> dashboard variable -> traces panel round-trip is the supported pattern. It stays in this browser tab, so it still reads as one window.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 41,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service_name\" && resource.deployment.environment = \"$deployment_environment\" && kind = server && span.http.route =~ \"$http_operation\" && span.http.request.method =~ \"$http_method\" && span.http.response.status_code >= $status_min && duration >= $min_duration } | select(span.http.request.method, span.http.route, span.http.response.status_code, resource.k8s.pod.name, resource.service.version)",
          "limit": 100,
          "spss": 1,
          "tableType": "spans",
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "links": [
            {
              "title": "▶ Load this request's waterfall (below)",
              "url": "/d/exora-g360-sre-v10/?${__url_time_range}&var-deployment_environment=${deployment_environment}&var-service_namespace=${service_namespace}&var-service_name=${service_name}&var-http_operation=${http_operation}&var-http_method=${http_method}&var-traceID=${__data.fields.traceIdHidden}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": false
              },
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "custom.width",
                "value": 250
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "▶ Load this request's waterfall below",
                    "url": "/d/exora-g360-sre-v10/?${__url_time_range}&var-deployment_environment=${deployment_environment}&var-service_namespace=${service_namespace}&var-service_name=${service_name}&var-http_operation=${http_operation}&var-http_method=${http_method}&var-log_level=${log_level}&var-traceID=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "yellow",
                      "value": 500000000
                    },
                    {
                      "color": "red",
                      "value": 2000000000
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*status_code.*"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "orange",
                      "value": 400
                    },
                    {
                      "color": "red",
                      "value": 500
                    }
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*http.route.*"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 340
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "duration",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 402,
      "title": "SELECTED TRACE — FULL WATERFALL:  HTTP → Controller → Service → Repository → JDBC → SQL → DB → Downstream",
      "description": "TEMPO / TraceQL trace-by-ID lookup on ${traceID}.\n\n'No data found in response' here means the Selected Trace ID variable is still empty — click the Trace ID column in the API REQUESTS table above, or paste an ID into the box at the top of the dashboard.\n\nExpand spans to read attributes: db.statement, db.system, Hikari pool timings, downstream http.url, exception events, and the gaps between siblings. Note that gateway proxy routes often produce a single-span trace; the deep JDBC/SQL chains show up on routes the gateway serves itself, such as /api/v1/permissions/me.",
      "type": "traces",
      "gridPos": {
        "x": 0,
        "y": 51,
        "w": 24,
        "h": 18
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "$traceID",
          "limit": 1000,
          "filters": []
        }
      ],
      "options": {},
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 403,
      "title": "LOGS FOR THE SELECTED TRACE",
      "description": "LOKI / LogQL. Loki's OTLP endpoint promotes service.name and the k8s.* resource attributes to labels; the log record's trace_id lands in structured metadata, which is what the `| trace_id=` filter matches. Requires -Dotel.logs.exporter=otlp on the app (you have it) — note the Instrumentation CR sets OTEL_LOGS_EXPORTER=none, and the -D system property is what overrides it.",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 69,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "editorMode": "code",
          "expr": "{service_name=\"$service_name\", k8s_namespace_name=\"$service_namespace\"} | trace_id=`$traceID`",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Ascending"
      }
    },
    {
      "id": 404,
      "title": "FAILED REQUESTS — traces with errors or 5xx",
      "description": "TEMPO / TraceQL. Root-cause list for the ERROR INVESTIGATION workflow. Click through to the waterfall the same way.",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 79,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service_name\" && kind = server && (status = error || span.http.response.status_code >= 500) } | select(span.http.request.method, span.http.route, span.http.response.status_code, resource.k8s.pod.name)",
          "limit": 50,
          "spss": 1,
          "tableType": "spans",
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "links": [
            {
              "title": "▶ Load this failed request's waterfall",
              "url": "/d/exora-g360-sre-v10/?${__url_time_range}&var-traceID=${__data.fields.traceIdHidden}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": false
              },
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "custom.width",
                "value": 250
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "▶ Load this failed request's waterfall",
                    "url": "/d/exora-g360-sre-v10/?${__url_time_range}&var-deployment_environment=${deployment_environment}&var-service_namespace=${service_namespace}&var-service_name=${service_name}&var-http_operation=${http_operation}&var-http_method=${http_method}&var-log_level=${log_level}&var-traceID=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true
      }
    },
    {
      "id": 405,
      "title": "SLOWEST JDBC / SQL SPANS",
      "description": "TEMPO / TraceQL. Prometheus only exposes HikariCP pool metrics (create / wait / use time) — it has no per-statement SQL latency. This panel is the per-statement view: it selects db spans directly out of Tempo, so you can see which SELECT is slow and jump to the whole request that issued it.",
      "type": "table",
      "gridPos": {
        "x": 12,
        "y": 79,
        "w": 12,
        "h": 9
      },
      "datasource": {
        "type": "tempo",
        "uid": "${tempo_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "${tempo_datasource}"
          },
          "queryType": "traceql",
          "query": "{ resource.service.name = \"$service_name\" && span.db.system != nil && duration >= $min_duration } | select(span.db.system, span.db.name, span.db.operation, span.db.sql.table, span.db.statement)",
          "limit": 50,
          "spss": 2,
          "tableType": "spans",
          "filters": []
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "links": [
            {
              "title": "▶ Load the full request that ran this SQL",
              "url": "/d/exora-g360-sre-v10/?${__url_time_range}&var-traceID=${__data.fields.traceIdHidden}",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "traceIdHidden"
            },
            "properties": [
              {
                "id": "custom.hidden",
                "value": false
              },
              {
                "id": "displayName",
                "value": "Trace ID"
              },
              {
                "id": "custom.width",
                "value": 250
              },
              {
                "id": "links",
                "value": [
                  {
                    "title": "▶ Load the full request that ran this SQL",
                    "url": "/d/exora-g360-sre-v10/?${__url_time_range}&var-deployment_environment=${deployment_environment}&var-service_namespace=${service_namespace}&var-service_name=${service_name}&var-http_operation=${http_operation}&var-http_method=${http_method}&var-log_level=${log_level}&var-traceID=${__value.raw}",
                    "targetBlank": false
                  }
                ]
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ns"
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "duration",
            "desc": true
          }
        ]
      }
    },
