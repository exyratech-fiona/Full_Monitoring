    {
      "id": 905,
      "title": "CPU throttling",
      "type": "stat",
      "gridPos": {
        "x": 16,
        "y": 179,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum(rate(container_cpu_cfs_throttled_periods_total{namespace=~\"$service_namespace\",pod=~\"$pod_name\",container!=\"\",container!=\"POD\"}[$__rate_interval])) / clamp_min(sum(rate(container_cpu_cfs_periods_total{namespace=~\"$service_namespace\",pod=~\"$pod_name\",container!=\"\",container!=\"POD\"}[$__rate_interval])), 0.001)",
          "range": true,
          "instant": false,
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "noValue": "0",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 5
              },
              {
                "color": "red",
                "value": 25
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "REQUIRES RESOURCE LIMITS. Verified 2026-08-11: the api-gateway-backend-dev container declares `resources: {}` - no requests, no limits. kube_pod_container_resource_limits therefore emits nothing, and with no CPU quota the kernel never populates the CFS throttling counters. Set requests/limits on the Deployment and this panel fills in by itself."
    },
    {
      "id": 906,
      "title": "Pod phase",
      "type": "stat",
      "gridPos": {
        "x": 20,
        "y": 179,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (phase) (kube_pod_status_phase{namespace=~\"$service_namespace\",pod=~\"$pod_name\"} > 0)",
          "range": true,
          "instant": false,
          "legendFormat": "{{phase}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "noValue": "—"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value_and_name",
        "orientation": "horizontal"
      }
    },
    {
      "id": 907,
      "title": "Pod CPU vs request / limit",
      "description": "Scoped to $k8s_workload — v9 showed every pod in the namespace because the Pod variable defaulted to All with no workload filter.\n\nThe usage series works; the dashed limit/request reference lines stay absent until the Deployment declares resources. REQUIRES RESOURCE LIMITS. Verified 2026-08-11: the api-gateway-backend-dev container declares `resources: {}` - no requests, no limits. kube_pod_container_resource_limits therefore emits nothing, and with no CPU quota the kernel never populates the CFS throttling counters. Set requests/limits on the Deployment and this panel fills in by itself.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 183,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=~\"$service_namespace\",pod=~\"$pod_name\",container!=\"POD\",container!=\"\"}[$__rate_interval])) * 1000",
          "range": true,
          "instant": false,
          "legendFormat": "{{pod}}",
          "interval": "2m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum(kube_pod_container_resource_limits{namespace=~\"$service_namespace\",pod=~\"$pod_name\",resource=\"cpu\"}) by (pod) * 1000",
          "range": true,
          "instant": false,
          "legendFormat": "limit {{pod}}"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "sum(kube_pod_container_resource_requests{namespace=~\"$service_namespace\",pod=~\"$pod_name\",resource=\"cpu\"}) by (pod) * 1000",
          "range": true,
          "instant": false,
          "legendFormat": "request {{pod}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "limit.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byRegexp",
              "options": "request.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "yellow"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dot",
                  "dash": [
                    2,
                    4
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 908,
      "title": "Pod memory vs limit",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 183,
        "w": 8,
        "h": 7
