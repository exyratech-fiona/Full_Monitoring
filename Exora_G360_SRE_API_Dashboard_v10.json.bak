    {
      "id": 900,
      "type": "row",
      "title": "KUBERNETES WORKLOAD — $k8s_workload",
      "gridPos": {
        "x": 0,
        "y": 178,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 901,
      "title": "Replicas ready / desired",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 179,
        "w": 4,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum(kube_deployment_status_replicas_ready{namespace=~\"$service_namespace\",deployment=~\"$k8s_workload\"})",
          "range": true,
