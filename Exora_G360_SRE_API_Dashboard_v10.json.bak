{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Container restarts",
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=~\"$service_namespace\",pod=~\"$pod_name\"}[$__interval]) > 0",
        "titleFormat": "Container restart",
        "textFormat": "{{pod}} / {{container}}",
        "step": "60s"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "sre",
    "apm",
    "opentelemetry",
    "exora",
    "api"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "timezone": "browser",
  "title": "Exora G360 — SRE / APM Request Journey (v10)",
  "uid": "exora-g360-sre-v10",
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "prometheus_datasource",
        "label": "Metrics DS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "tempo_datasource",
        "label": "Traces DS",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "current": {
          "text": "Tempo",
          "value": "tempo"
        }
      },
      {
        "name": "loki_datasource",
        "label": "Logs DS",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {
          "text": "Loki",
          "value": "loki"
        }
      },
      {
        "name": "deployment_environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count,deployment_environment)",
        "query": "label_values(http_server_request_duration_seconds_count,deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "dev",
          "value": "dev"
        },
        "description": "Sourced from the metric, not target_info. The OTel Java agent here emits the pre-semconv-1.27 attribute deployment.environment -> label deployment_environment. target_info additionally exposes deployment_environment_name, which does NOT exist on the metric series - reading the variable from target_info produced a value that matched nothing."
      },
      {
        "name": "service_namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{deployment_environment=~\"$deployment_environment\"},k8s_namespace_name)",
        "query": "label_values(http_server_request_duration_seconds_count{deployment_environment=~\"$deployment_environment\"},k8s_namespace_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "dev-greenfield",
          "value": "dev-greenfield"
        }
      },
      {
        "name": "service_name",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "description": "Sourced from the application metric, NOT from target_info. Prometheus' OTLP receiver turns service.name into the `job` label and strips it from target_info (keep_identifying_resource_attributes only exists in Prometheus 3.2+), so label_values(target_info, service_name) returns nothing on 2.55. promote_resource_attributes does put service_name on the metrics themselves, which is what this queries.",
        "definition": "label_values(http_server_request_duration_seconds_count,service_name)",
        "query": "label_values(http_server_request_duration_seconds_count,service_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "Exora-G360_Dev_API_Gateway",
          "value": "Exora-G360_Dev_API_Gateway"
        }
      },
      {
        "name": "http_operation",
        "label": "API Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_route)",
        "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_route)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "http_method",
        "label": "Method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_request_method)",
        "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_request_method)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "k8s_workload",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(kube_deployment_spec_replicas{namespace=~\"$service_namespace\"},deployment)",
        "query": "label_values(kube_deployment_spec_replicas{namespace=~\"$service_namespace\"},deployment)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "api-gateway-backend-dev",
          "value": "api-gateway-backend-dev"
        }
      },
      {
        "name": "pod_name",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(kube_pod_info{namespace=~\"$service_namespace\",pod=~\"$k8s_workload-.*\"},pod)",
        "query": "label_values(kube_pod_info{namespace=~\"$service_namespace\",pod=~\"$k8s_workload-.*\"},pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "$k8s_workload-.*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(node_load1,instance)",
        "query": "label_values(node_load1,instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "log_level",
        "label": "Log level",
        "type": "custom",
        "hide": 0,
        "description": "Loki 3.x derives detected_level automatically. Set to '.+' to see every line regardless of level.",
        "query": "error and warn : error|warn,errors only : error,all levels : .+",
        "options": [
          {
            "selected": true,
            "text": "error and warn",
            "value": "error|warn"
          },
          {
            "selected": false,
            "text": "errors only",
            "value": "error"
          },
          {
            "selected": false,
            "text": "all levels",
            "value": ".+"
          }
        ],
        "current": {
          "selected": true,
          "text": "error and warn",
          "value": "error|warn"
        }
      },
      {
        "name": "traceID",
        "label": "Selected Trace ID",
        "type": "textbox",
        "hide": 0,
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Populated automatically when you click a row in the API REQUESTS table. You can also paste a trace ID here."
      },
      {
        "name": "min_duration",
        "label": "Trace min duration",
        "type": "custom",
        "hide": 0,
        "query": "0ms,10ms,50ms,100ms,250ms,500ms,1s,2s,5s",
        "options": [
          {
            "selected": true,
            "text": "0ms",
            "value": "0ms"
          },
          {
            "selected": false,
            "text": "10ms",
            "value": "10ms"
          },
          {
            "selected": false,
            "text": "50ms",
            "value": "50ms"
          },
          {
            "selected": false,
            "text": "100ms",
            "value": "100ms"
          },
          {
            "selected": false,
            "text": "250ms",
            "value": "250ms"
          },
          {
            "selected": false,
            "text": "500ms",
            "value": "500ms"
          },
          {
            "selected": false,
            "text": "1s",
            "value": "1s"
          },
          {
            "selected": false,
            "text": "2s",
            "value": "2s"
          },
          {
            "selected": false,
            "text": "5s",
            "value": "5s"
          }
        ],
        "current": {
          "selected": true,
          "text": "0ms",
          "value": "0ms"
        }
      },
      {
        "name": "status_min",
        "label": "Trace min HTTP status",
        "type": "custom",
        "hide": 0,
        "query": "All : 0,4xx and 5xx only : 400,5xx only : 500",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "0"
          },
          {
            "selected": false,
            "text": "4xx and 5xx only",
            "value": "400"
          },
          {
            "selected": false,
            "text": "5xx only",
            "value": "500"
          }
        ],
        "current": {
          "selected": true,
          "text": "All",
          "value": "0"
        },
        "description": "TraceQL numeric floor on span.http.response.status_code. Display text vs substituted value: 'All' -> 0."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "Exora G360 — Single-Window Request Investigation",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 18,
        "h": 3
      },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "**Prometheus** = *how is the system performing?* &nbsp;•&nbsp; **Tempo** = *why was this one request slow?* &nbsp;•&nbsp; **Loki** = *what was logged?* &nbsp;•&nbsp; **Kubernetes** = *is the infrastructure healthy?*\n\nFlow: pick **Environment → Namespace → Service** → read **Golden Signals** → find the endpoint in **API Endpoint Performance** → click it to filter → pick a request in **API Requests** → click its **Trace ID** and the waterfall plus its logs load below, in this same window.\n\n*This gateway is bursty — measured idle in 64% of five-minute windows. Latency percentiles are undefined while traffic is paused, so those lines bridge idle gaps rather than break. Counters correctly read 0. Judge health over hours, not minutes.*"
      }
    },
    {
      "id": 2,
      "title": "Metrics freshness",
      "description": "Seconds since Prometheus last received an application metric sample over OTLP. Green = pipeline healthy. Red / No data = the collector is no longer delivering metrics to Prometheus, which makes every PromQL panel on this dashboard look empty or stale. Check the TELEMETRY PIPELINE HEALTH row at the bottom.",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 3
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "time() - max(max_over_time(timestamp(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})[$__range:1m]))",
          "range": false,
          "instant": true,
          "legendFormat": "age"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 0,
          "noValue": "NO METRICS",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 180
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      }
    },
    {
      "id": 50,
      "type": "row",
      "collapsed": true,
      "title": "START HERE — METRIC DISCOVERY (open this whenever panels are empty)",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 51,
          "type": "table",
          "title": "Which metric families actually exist in Prometheus (no filters at all)",
          "description": "Deliberately unfiltered and unscoped, so no dashboard variable can make it lie. If http_server_request_duration_seconds_count is MISSING here, the application's own OTLP metrics are not reaching Prometheus and no dashboard change can help — fix the pipeline. If calls_total / duration_milliseconds_* ARE here, open the SPANMETRICS FALLBACK row below: it rebuilds the golden signals and the endpoint table from the trace stream instead.",
          "gridPos": {
            "x": 0,
            "y": 4,
            "w": 12,
            "h": 10
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "targets": [
            {
              "refId": "A",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "format": "table",
              "expr": "count by (__name__) ({__name__=~\"http_server_request_duration_seconds_count|http_client_request_duration_seconds_count|jvm_memory_used_bytes|jvm_cpu_recent_utilization_ratio|jvm_thread_count|jvm_gc_duration_seconds_count|db_client_connections_usage|db_client_connections_use_time_milliseconds_count|traces_span_metrics_calls_total|traces_span_metrics_duration_milliseconds_count|traces_span_metrics_duration_milliseconds_bucket|traces_spanmetrics_calls_total|traces_service_graph_request_total|target_info\"})"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true
                },
                "renameByName": {
                  "__name__": "Metric",
                  "Value": "Series count"
                }
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "decimals": 0,
              "custom": {
                "align": "auto",
                "filterable": true
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Metric"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 430
                  }
                ]
              }
            ]
          },
          "options": {
            "cellHeight": "sm",
            "showHeader": true,
            "sortBy": [
              {
                "displayName": "Metric",
                "desc": false
              }
            ]
          }
        },
        {
          "id": 52,
          "type": "table",
          "title": "How stale is each family (seconds since its newest sample)",
          "description": "Green means Prometheus is currently being fed that family. Red or absent means the series exists in TSDB but nothing new is arriving — which is exactly what makes instant queries return 'No data' while range queries still show history.",
          "gridPos": {
            "x": 12,
            "y": 4,
            "w": 12,
            "h": 10
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "targets": [
            {
              "refId": "A",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "format": "table",
              "expr": "time() - max by (__name__) (max_over_time(timestamp({__name__=~\"http_server_request_duration_seconds_count|http_client_request_duration_seconds_count|jvm_memory_used_bytes|db_client_connections_usage|calls_total|duration_milliseconds_count|traces_spanmetrics_calls_total|traces_service_graph_request_total|target_info\"})[$__range:5m]))"
            }
          ],
          "transformations": [
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true
                },
                "renameByName": {
                  "__name__": "Metric",
                  "Value": "Sample age"
                }
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "decimals": 0,
              "custom": {
                "align": "auto",
                "filterable": true
              }
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Metric"
                },
                "properties": [
                  {
                    "id": "custom.width",
                    "value": 430
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "Sample age"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "s"
                  },
                  {
                    "id": "custom.cellOptions",
                    "value": {
                      "type": "color-background",
                      "mode": "gradient"
                    }
                  },
                  {
                    "id": "thresholds",
                    "value": {
                      "mode": "absolute",
                      "steps": [
                        {
                          "color": "green",
                          "value": null
                        },
                        {
                          "color": "yellow",
                          "value": 180
                        },
                        {
                          "color": "red",
                          "value": 600
                        }
                      ]
                    }
                  }
                ]
              }
            ]
          },
          "options": {
            "cellHeight": "sm",
            "showHeader": true
          }
        }
      ]
    },
    {
      "id": 60,
      "type": "row",
      "collapsed": true,
      "title": "SPANMETRICS FALLBACK — RED metrics rebuilt from traces (works while the app's OTLP metrics are down)",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 1
      },
      "panels": [
        {
          "id": 61,
          "type": "text",
          "title": "What this row is",
          "gridPos": {
            "x": 0,
            "y": 5,
            "w": 24,
            "h": 5
          },
          "transparent": true,
          "options": {
            "mode": "markdown",
            "content": "Your collector runs a **spanmetrics connector** (`05-otel-collector.yaml`) with `http.request.method`, `http.response.status_code` and `http.route` as dimensions. It derives RED metrics from the trace stream, so it keeps working even when the application's own OTLP metrics are being rejected — and your Pipeline Health row shows spans flowing at ~40/s with **zero** failures.\n\nThrough the Prometheus OTLP receiver these arrive as `traces_span_metrics_calls_total` and `traces_span_metrics_duration_milliseconds_{bucket,sum,count}` — confirmed present in your Prometheus on 2026-08-11. Note `traces_spanmetrics_calls_total` (no underscore between span and metrics) also exists: that one is Tempo's metrics-generator, which has no `http_route` dimension and cannot back an endpoint table.\n\nStated plainly: these are **trace-derived and sampling-dependent**, not the authoritative server histogram. Latency here is in **milliseconds**, and the resolution is the 11 explicit buckets from the collector config, so percentiles are coarser than the app's own histogram. This is a working substitute, not a replacement."
          }
        },
        {
          "id": 62,
          "type": "timeseries",
          "title": "Request rate by endpoint (spanmetrics)",
          "gridPos": {
            "x": 0,
            "y": 10,
            "w": 8,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "targets": [
            {
              "refId": "A",
              "editorMode": "code",
              "range": true,
              "instant": false,
              "legendFormat": "{{http_request_method}} {{http_route}}",
              "expr": "sum by (http_request_method, http_route) (rate(traces_span_metrics_calls_total{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval]))",
              "interval": "2m"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "decimals": 3,
              "custom": {
                "lineWidth": 2,
                "fillOpacity": 10,
                "spanNulls": true,
                "insertNulls": false
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": [
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 63,
          "type": "timeseries",
          "title": "P95 latency by endpoint (spanmetrics)",
          "gridPos": {
            "x": 8,
            "y": 10,
            "w": 8,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "targets": [
            {
              "refId": "A",
              "editorMode": "code",
              "range": true,
              "instant": false,
              "legendFormat": "{{http_route}}",
              "expr": "histogram_quantile(0.95, sum by (le, http_route) (rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\"}[$__rate_interval])))",
              "interval": "10m"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "ms",
              "decimals": 1,
              "custom": {
                "lineWidth": 2,
                "fillOpacity": 5,
                "spanNulls": true,
                "insertNulls": false
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": [
                "lastNotNull",
                "max"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          }
        },
        {
          "id": 64,
          "type": "timeseries",
          "title": "Errors by endpoint (spanmetrics)",
          "gridPos": {
            "x": 16,
            "y": 10,
            "w": 8,
            "h": 8
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "targets": [
            {
              "refId": "A",
              "editorMode": "code",
              "range": true,
              "instant": false,
              "legendFormat": "5xx {{http_route}}",
              "expr": "sum by (http_route) (rate(traces_span_metrics_calls_total{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"5..\"}[$__rate_interval]))",
              "interval": "2m"
            },
            {
              "refId": "B",
              "editorMode": "code",
              "range": true,
              "instant": false,
              "legendFormat": "span error {{http_route}}",
              "expr": "sum by (http_route) (rate(traces_span_metrics_calls_total{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\",status_code=\"STATUS_CODE_ERROR\"}[$__rate_interval]))",
              "interval": "2m"
            },
            {
              "refId": "C",
              "editorMode": "code",
              "range": true,
              "instant": false,
              "interval": "2m",
              "legendFormat": "TOTAL 5xx (0 = no errors)",
              "expr": "sum(rate(traces_span_metrics_calls_total{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"5..\"}[$__rate_interval])) or vector(0)"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "reqps",
              "decimals": 3,
              "custom": {
                "lineWidth": 2,
                "fillOpacity": 10,
                "spanNulls": true,
                "insertNulls": false
              }
            },
            "overrides": []
          },
          "options": {
            "legend": {
              "displayMode": "table",
              "placement": "right",
              "calcs": [
                "lastNotNull"
              ]
            },
            "tooltip": {
              "mode": "multi",
              "sort": "desc"
            }
          },
          "description": "Per-route series only appear once a route has actually errored. The TOTAL line is pinned with `or vector(0)` so a healthy service shows a flat zero instead of an empty panel."
        },
        {
          "id": 65,
          "type": "table",
          "title": "API Endpoint Performance (spanmetrics)",
          "description": "Same shape as the Prometheus endpoint table, rebuilt from calls_total / duration_milliseconds_*. Latency columns are milliseconds. Clicking a row sets the same API Route + Method variables, so the Tempo trace drilldown below still works unchanged.",
          "gridPos": {
            "x": 0,
            "y": 18,
            "w": 24,
            "h": 11
          },
          "datasource": {
            "type": "prometheus",
            "uid": "${prometheus_datasource}"
          },
          "targets": [
            {
              "refId": "A",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "format": "table",
              "expr": "sum by (endpoint, http_request_method, http_route) (label_join(increase(traces_span_metrics_calls_total{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\"}[$__range]), \"endpoint\", \" \", \"http_request_method\", \"http_route\"))"
            },
            {
              "refId": "B",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "format": "table",
              "expr": "sum by (endpoint) (label_join(rate(traces_span_metrics_calls_total{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\"}[$__range]), \"endpoint\", \" \", \"http_request_method\", \"http_route\"))"
            },
            {
              "refId": "C",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "format": "table",
              "expr": "histogram_quantile(0.50, sum by (le, endpoint) (label_join(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\"}[$__range]), \"endpoint\", \" \", \"http_request_method\", \"http_route\")))"
            },
            {
              "refId": "D",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "format": "table",
              "expr": "histogram_quantile(0.95, sum by (le, endpoint) (label_join(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\"}[$__range]), \"endpoint\", \" \", \"http_request_method\", \"http_route\")))"
            },
            {
              "refId": "E",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "format": "table",
              "expr": "histogram_quantile(0.99, sum by (le, endpoint) (label_join(rate(traces_span_metrics_duration_milliseconds_bucket{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\"}[$__range]), \"endpoint\", \" \", \"http_request_method\", \"http_route\")))"
            },
            {
              "refId": "F",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "format": "table",
              "expr": "sum by (endpoint) (label_join(increase(traces_span_metrics_calls_total{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"4..\"}[$__range]), \"endpoint\", \" \", \"http_request_method\", \"http_route\"))"
            },
            {
              "refId": "G",
              "editorMode": "code",
              "instant": true,
              "range": false,
              "format": "table",
              "expr": "sum by (endpoint) (label_join(increase(traces_span_metrics_calls_total{service_name=~\"$service_name\",span_kind=\"SPAN_KIND_SERVER\",http_response_status_code=~\"5..\"}[$__range]), \"endpoint\", \" \", \"http_request_method\", \"http_route\"))"
            }
          ],
          "transformations": [
            {
              "id": "joinByField",
              "options": {
                "byField": "endpoint",
                "mode": "outer"
              }
            },
            {
              "id": "organize",
              "options": {
                "excludeByName": {
                  "Time": true,
                  "Time 1": true,
                  "endpoint": true
                },
                "indexByName": {
                  "http_request_method": 0,
                  "http_route": 1,
                  "Value #A": 2,
                  "Value #B": 3,
                  "Value #C": 4,
                  "Value #D": 5,
                  "Value #E": 6,
                  "Value #F": 7,
                  "Value #G": 8
                },
                "renameByName": {
                  "http_request_method": "Method",
                  "http_route": "Endpoint",
                  "Value #A": "Requests",
                  "Value #B": "RPS",
                  "Value #C": "P50",
                  "Value #D": "P95",
                  "Value #E": "P99",
                  "Value #F": "4xx",
                  "Value #G": "5xx"
                }
              }
            }
          ],
          "fieldConfig": {
            "defaults": {
              "decimals": 2,
              "custom": {
                "align": "auto",
                "filterable": true
              },
              "links": [
                {
                  "title": "Drill into this endpoint (sets API Route + Method)",
                  "targetBlank": false,
                  "url": "/d/exora-g360-sre-v10/?${__url_time_range}&var-service_name=${service_name}&var-http_operation=${__data.fields.Endpoint:percentencode}&var-http_method=${__data.fields.Method:percentencode}"
                }
              ]
            },
            "overrides": [
              {
                "matcher": {
                  "id": "byName",
                  "options": "Requests"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "short"
                  },
                  {
                    "id": "decimals",
                    "value": 0
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "RPS"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "reqps"
                  },
                  {
                    "id": "decimals",
                    "value": 3
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "P50"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "ms"
                  },
                  {
                    "id": "decimals",
                    "value": 1
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "P95"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "ms"
                  },
                  {
                    "id": "decimals",
                    "value": 1
                  }
                ]
              },
              {
                "matcher": {
                  "id": "byName",
                  "options": "P99"
                },
                "properties": [
                  {
                    "id": "unit",
                    "value": "ms"
                  },
                  {
                    "id": "decimals",
                    "value": 1
                  },
                  {
                    "id": "custom.cellOptions",
                    "value": {
                      "type": "color-text"
                    }
                  },
                  {
                    "id": "thresholds",
                    "value": {
                      "mode": "absolute",
                      "steps": [
                        {
                          "color": "green",
