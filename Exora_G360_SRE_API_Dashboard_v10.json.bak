    {
      "id": 500,
      "type": "row",
      "title": "ERROR INVESTIGATION",
      "gridPos": {
        "x": 0,
        "y": 96,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 501,
      "title": "HTTP status distribution",
      "type": "piechart",
      "gridPos": {
        "x": 0,
        "y": 97,
        "w": 6,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (http_response_status_code) (increase(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__range]))",
          "range": false,
          "instant": true,
          "legendFormat": "{{http_response_status_code}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "pieType": "donut",
        "displayLabels": [
          "percent"
        ],
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "values": [
            "value"
          ]
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 502,
      "title": "Top failing endpoints (4xx / 5xx)",
      "type": "table",
      "gridPos": {
        "x": 6,
        "y": 97,
        "w": 18,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "topk(15, sum by (http_request_method, http_route, http_response_status_code) (increase(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",http_response_status_code=~\"[45]..\"}[$__range])))",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {
              "http_request_method": 0,
              "http_route": 1,
              "http_response_status_code": 2,
              "Value": 3
            },
            "renameByName": {
              "http_request_method": "Method",
              "http_route": "Endpoint",
              "http_response_status_code": "Status",
              "Value": "Failures"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 0,
          "custom": {
            "align": "auto",
            "filterable": true
          },
          "links": [
            {
              "title": "Drill into this endpoint",
              "url": "/d/exora-g360-sre-v10/?${__url_time_range}&var-http_operation=${__data.fields.Endpoint:percentencode}&var-http_method=${__data.fields.Method:percentencode}&var-status_min=400",
              "targetBlank": false
            }
          ]
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Failures"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              },
              {
                "id": "custom.width",
                "value": 260
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Endpoint"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 420
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Failures",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 503,
      "title": "Application logs",
      "description": "LOKI / LogQL. Verified label set on your Loki: service_name, k8s_namespace_name, k8s_pod_name, k8s_deployment_name, k8s_container_name, deployment_environment, service_instance_id - plus detected_level, which Loki 3.x derives per line. Switch the 'Log level' variable to 'all levels' to see everything.",
      "type": "logs",
      "gridPos": {
        "x": 0,
        "y": 106,
        "w": 24,
        "h": 10
      },
      "datasource": {
        "type": "loki",
        "uid": "${loki_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "${loki_datasource}"
          },
          "editorMode": "code",
          "expr": "{service_name=\"$service_name\", k8s_namespace_name=\"$service_namespace\"} | detected_level=~\"$log_level\"",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
    {
      "id": 600,
      "type": "row",
      "title": "SERVICE TOPOLOGY & OUTBOUND DEPENDENCIES",
      "gridPos": {
        "x": 0,
        "y": 116,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 601,
      "title": "Service dependency map",
      "description": "PROMETHEUS / PromQL over Tempo metrics-generator series (traces_service_graph_*). Dependency overview only — it has no endpoint dimension. Use the trace waterfall for endpoint-level and request-level investigation.",
      "type": "nodeGraph",
      "gridPos": {
        "x": 0,
        "y": 117,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "edges",
          "editorMode": "code",
          "expr": "label_join(label_join(label_join(\n  sum by (client, server) (increase(traces_service_graph_request_total{client!=\"\",server!=\"\"}[$__range])) > 0,\n  \"source\", \"\", \"client\"),\n  \"target\", \"\", \"server\"),\n  \"id\", \"->\", \"client\", \"server\")",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "options": {
        "nodes": {
          "arcs": []
        },
        "edges": {}
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      }
    },
    {
      "id": 602,
      "title": "Outbound HTTP — request rate",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 126,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (server_address, http_request_method) (rate(http_client_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{http_request_method}} {{server_address}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 3,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 603,
      "title": "Outbound HTTP — P50 / P95 / P99",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 126,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, server_address) (rate(http_client_request_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P50 {{server_address}}",
          "interval": "10m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, server_address) (rate(http_client_request_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P95 {{server_address}}",
          "interval": "10m"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, server_address) (rate(http_client_request_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P99 {{server_address}}",
          "interval": "10m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 3,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 604,
      "title": "Outbound HTTP — 5xx %",
      "description": "Per-destination denominator so a busy destination cannot mask a failing one. Destinations with no 5xx plot a real 0 rather than dropping out of the result - an empty ratio panel is indistinguishable from a broken one.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 126,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (sum by (server_address, http_request_method) (rate(http_client_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",http_response_status_code=~\"5..\"}[$__rate_interval])) or sum by (server_address, http_request_method) (rate(http_client_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])) * 0) / sum by (server_address, http_request_method) (rate(http_client_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{http_request_method}} {{server_address}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 605,
      "title": "Outbound dependencies — summary",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 133,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (dep, server_address, http_request_method) (label_join(increase(http_client_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__range]), \"dep\", \" \", \"http_request_method\", \"server_address\"))",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, dep) (label_join(rate(http_client_request_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__range]), \"dep\", \" \", \"http_request_method\", \"server_address\")))",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, dep) (label_join(rate(http_client_request_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__range]), \"dep\", \" \", \"http_request_method\", \"server_address\")))",
          "range": false,
          "instant": true,
          "format": "table"
        },
        {
          "refId": "D",
          "editorMode": "code",
          "expr": "sum by (dep) (label_join(increase(http_client_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",http_response_status_code=~\"5..\"}[$__range]), \"dep\", \" \", \"http_request_method\", \"server_address\")) or sum by (dep) (label_join(increase(http_client_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__range]), \"dep\", \" \", \"http_request_method\", \"server_address\")) * 0",
          "range": false,
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "dep",
            "mode": "outer"
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Time 1": true,
              "dep": true
            },
            "indexByName": {
              "http_request_method": 0,
              "server_address": 1,
              "Value #A": 2,
              "Value #B": 3,
              "Value #C": 4,
              "Value #D": 5
            },
            "renameByName": {
              "http_request_method": "Method",
              "server_address": "Destination",
              "Value #A": "Calls",
              "Value #B": "P95",
              "Value #C": "P99",
              "Value #D": "5xx"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "custom": {
            "align": "auto",
            "filterable": true
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Calls"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P95"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P99"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 3
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "5xx"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "gradient"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "transparent",
                      "value": null
                    },
                    {
                      "color": "dark-red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "cellHeight": "sm",
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Calls",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 700,
      "type": "row",
      "title": "DATABASE / JDBC CONNECTION POOL",
      "gridPos": {
        "x": 0,
        "y": 141,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 701,
      "title": "Connection pool — used vs idle",
      "description": "db_client_connections_usage{state=\"used|idle\"} plus db_client_connections_max. v9 queried db_client_operation_duration_seconds_*, which the OTel Java agent does not emit for JDBC — that is why the DB panels were empty.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 142,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (pool_name, state) (db_client_connections_usage{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool_name}} {{state}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (pool_name) (db_client_connections_max{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool_name}} max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*max"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 702,
      "title": "Connection pool saturation",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 142,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum by (pool_name) (db_client_connections_usage{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",state=\"used\"}) / clamp_min(sum by (pool_name) (db_client_connections_max{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}), 1)",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "max": 100,
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "spanNulls": true,
            "insertNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 703,
      "title": "Pending connection requests",
      "description": "Anything above zero on 'pending' means threads are blocked waiting for a JDBC connection — the classic cause of a fast SQL query inside a slow HTTP request. NOTE: db_client_connections_timeouts_total is not emitted by your OTel Java agent build (verified against the Prometheus label API on 2026-08-11), so there is no pool-timeout series to chart; a sustained pending count is the signal to watch instead.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 142,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (pool_name) (db_client_connections_pending_requests{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "pending {{pool_name}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "idle floor {{pool_name}}",
          "expr": "sum by (pool_name) (db_client_connections_idle_min{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 704,
      "title": "Connection WAIT time (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 149,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, pool_name) (rate(db_client_connections_wait_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P50 {{pool_name}}",
          "interval": "10m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, pool_name) (rate(db_client_connections_wait_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P95 {{pool_name}}",
          "interval": "10m"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, pool_name) (rate(db_client_connections_wait_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P99 {{pool_name}}",
          "interval": "10m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 705,
      "title": "Connection USE time (P95 / P99)",
      "description": "How long a borrowed connection is held — the closest Prometheus-side proxy for query duration. Per-statement SQL timing lives in the Tempo JDBC spans panel above.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 149,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, pool_name) (rate(db_client_connections_use_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P95 {{pool_name}}",
          "interval": "10m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, pool_name) (rate(db_client_connections_use_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P99 {{pool_name}}",
          "interval": "10m"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "sum by (pool_name) (rate(db_client_connections_use_time_milliseconds_sum{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])) / sum by (pool_name) (rate(db_client_connections_use_time_milliseconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "Avg {{pool_name}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 706,
      "title": "Connection CREATE time + borrow rate",
      "description": "A rising create time or a high borrow rate with a saturated pool points at pool sizing rather than at the query.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 149,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, pool_name) (rate(db_client_connections_create_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "create P95 {{pool_name}}",
          "interval": "10m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (pool_name) (rate(db_client_connections_use_time_milliseconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "borrows/s {{pool_name}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "borrows.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 800,
      "type": "row",
      "title": "JVM RUNTIME HEALTH",
      "gridPos": {
        "x": 0,
        "y": 156,
        "w": 24,
        "h": 1
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 801,
      "title": "JVM CPU",
      "description": "v9 queried jvm_cpu_utilization_ratio, which does not exist. The OTel Java agent emits jvm.cpu.recent_utilization -> jvm_cpu_recent_utilization_ratio. Series B derives the same number from jvm_cpu_time_seconds_total / jvm_cpu_count as a fallback for older agent versions.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 157,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * avg by (k8s_pod_name) (jvm_cpu_recent_utilization_ratio{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "recent {{k8s_pod_name}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "100 * sum by (k8s_pod_name) (rate(jvm_cpu_time_seconds_total{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])) / clamp_min(sum by (k8s_pod_name) (jvm_cpu_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}), 1)",
          "range": true,
          "instant": false,
          "legendFormat": "from cpu.time {{k8s_pod_name}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 802,
      "title": "JVM heap — used / committed / max",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 157,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (k8s_pod_name) (jvm_memory_used_bytes{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",jvm_memory_type=\"heap\"})",
          "range": true,
          "instant": false,
          "legendFormat": "used {{k8s_pod_name}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (k8s_pod_name) (jvm_memory_committed_bytes{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",jvm_memory_type=\"heap\"})",
          "range": true,
          "instant": false,
          "legendFormat": "committed {{k8s_pod_name}}"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "sum by (k8s_pod_name) (jvm_memory_limit_bytes{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",jvm_memory_type=\"heap\"})",
          "range": true,
          "instant": false,
          "legendFormat": "max {{k8s_pod_name}}"
        },
        {
          "refId": "D",
          "editorMode": "code",
          "expr": "sum by (k8s_pod_name) (jvm_memory_used_after_last_gc_bytes{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",jvm_memory_type=\"heap\"})",
          "range": true,
          "instant": false,
          "legendFormat": "live set after GC {{k8s_pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 5,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "max.*"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 803,
      "title": "JVM heap utilisation (% of max)",
      "description": "Percent of jvm_memory_limit_bytes (true -Xmx), not of committed. v9 divided by committed, which understates pressure because committed grows with usage.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 157,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum by (k8s_pod_name) (jvm_memory_used_bytes{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",jvm_memory_type=\"heap\"}) / clamp_min(sum by (k8s_pod_name) (jvm_memory_limit_bytes{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",jvm_memory_type=\"heap\"}), 1)",
          "range": true,
          "instant": false,
          "legendFormat": "{{k8s_pod_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "spanNulls": true,
            "insertNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 804,
      "title": "JVM non-heap + memory by pool",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 164,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (jvm_memory_pool_name) (jvm_memory_used_bytes{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{jvm_memory_pool_name}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum (jvm_memory_used_bytes{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",jvm_memory_type=\"non_heap\"})",
          "range": true,
          "instant": false,
          "legendFormat": "TOTAL non-heap"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 2,
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 805,
      "title": "GC — time per second & pause P99",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 164,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (jvm_gc_name) (rate(jvm_gc_duration_seconds_sum{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "GC s/s {{jvm_gc_name}}",
          "interval": "2m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, jvm_gc_name) (rate(jvm_gc_duration_seconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "pause P99 {{jvm_gc_name}}",
          "interval": "10m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 4,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 806,
      "title": "GC — collections per second",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 164,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (jvm_gc_name, jvm_gc_action) (rate(jvm_gc_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "{{jvm_gc_name}} / {{jvm_gc_action}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "decimals": 3,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 807,
      "title": "JVM threads — live / by state / peak",
      "description": "OTel's JVM instrumentation does not emit a peak-threads gauge (that is a Micrometer metric). 'peak (observed)' below is max_over_time() across the selected range, which is the honest equivalent from OTel data.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 171,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum (jvm_thread_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "live threads"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (jvm_thread_state) (jvm_thread_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{jvm_thread_state}}"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "max_over_time(sum(jvm_thread_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})[$__range:1m])",
          "range": true,
          "instant": false,
          "legendFormat": "peak (observed)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "peak (observed)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "live threads"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "right",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 808,
      "title": "JVM threads — daemon vs application",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 171,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
