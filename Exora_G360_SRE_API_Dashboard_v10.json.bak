    {
      "id": 106,
      "title": "Average latency",
      "description": "sum(rate(_sum)) / sum(rate(_count)). NOTE: v9 wrapped the denominator in clamp_min(...,1), which silently divided by 1 whenever RPS < 1 and reported a near-zero average. That clamp is removed here.",
      "type": "stat",
      "gridPos": {
        "x": 15,
        "y": 6,
        "w": 3,
        "h": 4
      },
