{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Container restarts",
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=~\"$service_namespace\",pod=~\"$pod_name\"}[$__interval]) > 0",
        "titleFormat": "Container restart",
        "textFormat": "{{pod}} / {{container}}",
        "step": "60s"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "sre",
    "apm",
    "devopslabs",
    "kubernetes",
    "node",
    "quick-view"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "timezone": "browser",
  "title": "DevopsLabs — Node Health",
  "uid": "exora-g360-infra-node-health",
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "prometheus_datasource",
        "label": "Metrics DS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "tempo_datasource",
        "label": "Traces DS",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "current": {
          "text": "Tempo",
          "value": "tempo"
        }
      },
      {
        "name": "loki_datasource",
        "label": "Logs DS",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {
          "text": "Loki",
          "value": "loki"
        }
      },
      {
        "name": "deployment_environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count,deployment_environment)",
        "query": "label_values(http_server_request_duration_seconds_count,deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "description": "Sourced from the metric, not target_info. The OTel Java agent here emits the pre-semconv-1.27 attribute deployment.environment -> label deployment_environment. target_info additionally exposes deployment_environment_name, which does NOT exist on the metric series - reading the variable from target_info produced a value that matched nothing.",
        "hide": 2
      },
      {
        "name": "service_namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{deployment_environment=~\"$deployment_environment\"},k8s_namespace_name)",
        "query": "label_values(http_server_request_duration_seconds_count{deployment_environment=~\"$deployment_environment\"},k8s_namespace_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "dev-greenfield",
          "value": "dev-greenfield"
        }
      },
      {
        "name": "service_name",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "description": "Sourced from the application metric, NOT from target_info. Prometheus' OTLP receiver turns service.name into the `job` label and strips it from target_info (keep_identifying_resource_attributes only exists in Prometheus 3.2+), so label_values(target_info, service_name) returns nothing on 2.55. promote_resource_attributes does put service_name on the metrics themselves, which is what this queries.",
        "definition": "label_values(http_server_request_duration_seconds_count,service_name)",
        "query": "label_values(http_server_request_duration_seconds_count,service_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "Exora-G360_Dev_API_Gateway",
          "value": "Exora-G360_Dev_API_Gateway"
        }
      },
      {
        "name": "http_operation",
        "label": "API Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_route)",
        "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_route)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "http_method",
        "label": "Method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_request_method)",
        "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_request_method)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "k8s_workload",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},k8s_deployment_name)",
        "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},k8s_deployment_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "api-gateway-backend-dev",
          "value": "api-gateway-backend-dev"
        }
      },
      {
        "name": "pod_name",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(kube_pod_info{namespace=~\"$service_namespace\",pod=~\"$k8s_workload-.*\"},pod)",
        "query": "label_values(kube_pod_info{namespace=~\"$service_namespace\",pod=~\"$k8s_workload-.*\"},pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "$k8s_workload-.*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(node_load1,instance)",
        "query": "label_values(node_load1,instance)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "log_level",
        "label": "Log level",
        "type": "custom",
        "hide": 0,
        "description": "Loki 3.x derives detected_level automatically. Set to '.+' to see every line regardless of level.",
        "query": "error and warn : error|warn,errors only : error,all levels : .+",
        "options": [
          {
            "selected": true,
            "text": "error and warn",
            "value": "error|warn"
          },
          {
            "selected": false,
            "text": "errors only",
            "value": "error"
          },
          {
            "selected": false,
            "text": "all levels",
            "value": ".+"
          }
        ],
        "current": {
          "selected": true,
          "text": "error and warn",
          "value": "error|warn"
        }
      },
      {
        "name": "traceID",
        "label": "Selected Trace ID",
        "type": "textbox",
        "hide": 0,
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Populated automatically when you click a row in the API REQUESTS table. You can also paste a trace ID here."
      },
      {
        "name": "min_duration",
        "label": "Trace min duration",
        "type": "custom",
        "hide": 0,
        "query": "0ms,10ms,50ms,100ms,250ms,500ms,1s,2s,5s",
        "options": [
          {
            "selected": true,
            "text": "0ms",
            "value": "0ms"
          },
          {
            "selected": false,
            "text": "10ms",
            "value": "10ms"
          },
          {
            "selected": false,
            "text": "50ms",
            "value": "50ms"
          },
          {
            "selected": false,
            "text": "100ms",
            "value": "100ms"
          },
          {
            "selected": false,
            "text": "250ms",
            "value": "250ms"
          },
          {
            "selected": false,
            "text": "500ms",
            "value": "500ms"
          },
          {
            "selected": false,
            "text": "1s",
            "value": "1s"
          },
          {
            "selected": false,
            "text": "2s",
            "value": "2s"
          },
          {
            "selected": false,
            "text": "5s",
            "value": "5s"
          }
        ],
        "current": {
          "selected": true,
          "text": "0ms",
          "value": "0ms"
        }
      },
      {
        "name": "status_min",
        "label": "Trace min HTTP status",
        "type": "custom",
        "hide": 0,
        "query": "All : 0,4xx and 5xx only : 400,5xx only : 500",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "0"
          },
          {
            "selected": false,
            "text": "4xx and 5xx only",
            "value": "400"
          },
          {
            "selected": false,
            "text": "5xx only",
            "value": "500"
          }
        ],
        "current": {
          "selected": true,
          "text": "All",
          "value": "0"
        },
        "description": "TraceQL numeric floor on span.http.response.status_code. Display text vs substituted value: 'All' -> 0."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "DevopsLabs — Node Health",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "Health of the underlying Kubernetes node(s) this app runs on — CPU, memory, load, disk, network, pod density, and node conditions."
      }
    },
    {
      "id": 1001,
      "title": "Node CPU utilisation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\",instance=~\"$node\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "{{instance}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Simple: How busy the physical/virtual server (node) itself is, CPU-wise."
    },
    {
      "id": 1002,
      "title": "Node memory utilisation",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (1 - (node_memory_MemAvailable_bytes{instance=~\"$node\"} / node_memory_MemTotal_bytes{instance=~\"$node\"}))",
          "range": true,
          "instant": false,
          "legendFormat": "{{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Simple: How much memory the server itself has used, independent of any one app."
    },
    {
      "id": 1003,
      "title": "Node load (1m / 5m / 15m per core)",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "node_load1{instance=~\"$node\"} / on(instance) group_left count by (instance) (node_cpu_seconds_total{mode=\"idle\",instance=~\"$node\"})",
          "range": true,
          "instant": false,
          "legendFormat": "load1/core {{instance}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "node_load15{instance=~\"$node\"} / on(instance) group_left count by (instance) (node_cpu_seconds_total{mode=\"idle\",instance=~\"$node\"})",
          "range": true,
          "instant": false,
          "legendFormat": "load15/core {{instance}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Simple: How many processes are waiting for CPU time on the server, averaged over 1/5/15 minutes."
    },
    {
      "id": 1004,
      "title": "Node filesystem utilisation",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * (1 - (node_filesystem_avail_bytes{instance=~\"$node\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/run.*|/var/lib/kubelet.*\"} / node_filesystem_size_bytes{instance=~\"$node\",fstype!~\"tmpfs|overlay|squashfs\",mountpoint!~\"/run.*|/var/lib/kubelet.*\"}))",
          "range": true,
          "instant": false,
          "legendFormat": "{{instance}} {{mountpoint}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "max": 100,
          "custom": {
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "spanNulls": true,
            "insertNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 80
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Simple: How full the server's disk is."
    },
    {
      "id": 1005,
      "title": "Node disk I/O",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (instance) (rate(node_disk_read_bytes_total{instance=~\"$node\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "read {{instance}}",
          "interval": "2m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "-sum by (instance) (rate(node_disk_written_bytes_total{instance=~\"$node\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "write {{instance}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Simple: How much read/write activity is happening on the server's disk."
    },
    {
      "id": 1006,
      "title": "Node network RX / TX",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (instance) (rate(node_network_receive_bytes_total{instance=~\"$node\",device!~\"lo|veth.*|cali.*|tunl.*|flannel.*|cni.*\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "RX {{instance}}",
          "interval": "2m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "-sum by (instance) (rate(node_network_transmit_bytes_total{instance=~\"$node\",device!~\"lo|veth.*|cali.*|tunl.*|flannel.*|cni.*\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "TX {{instance}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Simple: Total network traffic in and out of the server."
    },
    {
      "id": 1007,
      "title": "Pod density (running / allocatable)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "count by (node) (kube_pod_info{node=~\"$node\"})",
          "range": true,
          "instant": false,
          "legendFormat": "pods {{node}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (node) (kube_node_status_allocatable{resource=\"pods\",node=~\"$node\"})",
          "range": true,
          "instant": false,
          "legendFormat": "allocatable {{node}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Simple: How many pods are running on the node versus how many it can hold."
    },
    {
      "id": 1008,
      "title": "Node conditions",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 17,
        "w": 12,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (node, condition) (kube_node_status_condition{condition!=\"Ready\",status=\"true\"} > 0) or vector(0)",
          "range": true,
          "instant": false,
          "legendFormat": "{{node}} {{condition}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
