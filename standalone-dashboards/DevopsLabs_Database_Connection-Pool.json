{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      },
      {
        "name": "Container restarts",
        "enable": true,
        "hide": false,
        "iconColor": "red",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "expr": "changes(kube_pod_container_status_restarts_total{namespace=~\"$service_namespace\",pod=~\"$pod_name\"}[$__interval]) > 0",
        "titleFormat": "Container restart",
        "textFormat": "{{pod}} / {{container}}",
        "step": "60s"
      }
    ]
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": [
    "sre",
    "apm",
    "devopslabs",
    "database",
    "jdbc",
    "quick-view"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "1h"
    ]
  },
  "timezone": "browser",
  "title": "DevopsLabs — Database / JDBC Connection Pool",
  "uid": "exora-g360-database-connection-pool",
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "prometheus_datasource",
        "label": "Metrics DS",
        "type": "datasource",
        "query": "prometheus",
        "hide": 0,
        "current": {
          "text": "Prometheus",
          "value": "prometheus"
        }
      },
      {
        "name": "tempo_datasource",
        "label": "Traces DS",
        "type": "datasource",
        "query": "tempo",
        "hide": 0,
        "current": {
          "text": "Tempo",
          "value": "tempo"
        }
      },
      {
        "name": "loki_datasource",
        "label": "Logs DS",
        "type": "datasource",
        "query": "loki",
        "hide": 0,
        "current": {
          "text": "Loki",
          "value": "loki"
        }
      },
      {
        "name": "deployment_environment",
        "label": "Environment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count,deployment_environment)",
        "query": "label_values(http_server_request_duration_seconds_count,deployment_environment)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": ".*"
        },
        "description": "Sourced from the metric, not target_info. The OTel Java agent here emits the pre-semconv-1.27 attribute deployment.environment -> label deployment_environment. target_info additionally exposes deployment_environment_name, which does NOT exist on the metric series - reading the variable from target_info produced a value that matched nothing.",
        "hide": 2
      },
      {
        "name": "service_namespace",
        "label": "Namespace",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{deployment_environment=~\"$deployment_environment\"},k8s_namespace_name)",
        "query": "label_values(http_server_request_duration_seconds_count{deployment_environment=~\"$deployment_environment\"},k8s_namespace_name)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "dev-greenfield",
          "value": "dev-greenfield"
        }
      },
      {
        "name": "service_name",
        "label": "Service",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "description": "Sourced from the application metric, NOT from target_info. Prometheus' OTLP receiver turns service.name into the `job` label and strips it from target_info (keep_identifying_resource_attributes only exists in Prometheus 3.2+), so label_values(target_info, service_name) returns nothing on 2.55. promote_resource_attributes does put service_name on the metrics themselves, which is what this queries.",
        "definition": "label_values(http_server_request_duration_seconds_count,service_name)",
        "query": "label_values(http_server_request_duration_seconds_count,service_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "Exora-G360_Dev_API_Gateway",
          "value": "Exora-G360_Dev_API_Gateway"
        }
      },
      {
        "name": "http_operation",
        "label": "API Route",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_route)",
        "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_route)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "http_method",
        "label": "Method",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_request_method)",
        "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},http_request_method)",
        "refresh": 2,
        "includeAll": true,
        "multi": false,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": ".*"
        }
      },
      {
        "name": "k8s_workload",
        "label": "Deployment",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},k8s_deployment_name)",
        "query": "label_values(http_server_request_duration_seconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"},k8s_deployment_name)",
        "refresh": 2,
        "includeAll": false,
        "multi": false,
        "sort": 1,
        "current": {
          "text": "api-gateway-backend-dev",
          "value": "api-gateway-backend-dev"
        }
      },
      {
        "name": "pod_name",
        "label": "Pod",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(kube_pod_info{namespace=~\"$service_namespace\",pod=~\"$k8s_workload-.*\"},pod)",
        "query": "label_values(kube_pod_info{namespace=~\"$service_namespace\",pod=~\"$k8s_workload-.*\"},pod)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": "$k8s_workload-.*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "node",
        "label": "Node",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${prometheus_datasource}"
        },
        "definition": "label_values(kube_pod_info{namespace=~\"$service_namespace\",pod=~\"$pod_name\"},node)",
        "query": "label_values(kube_pod_info{namespace=~\"$service_namespace\",pod=~\"$pod_name\"},node)",
        "refresh": 2,
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "sort": 1,
        "current": {
          "text": "All",
          "value": [
            "$__all"
          ]
        }
      },
      {
        "name": "log_level",
        "label": "Log level",
        "type": "custom",
        "hide": 0,
        "description": "Loki 3.x derives detected_level automatically. Set to '.+' to see every line regardless of level.",
        "query": "error and warn : error|warn,errors only : error,all levels : .+",
        "options": [
          {
            "selected": true,
            "text": "error and warn",
            "value": "error|warn"
          },
          {
            "selected": false,
            "text": "errors only",
            "value": "error"
          },
          {
            "selected": false,
            "text": "all levels",
            "value": ".+"
          }
        ],
        "current": {
          "selected": true,
          "text": "error and warn",
          "value": "error|warn"
        }
      },
      {
        "name": "traceID",
        "label": "Selected Trace ID",
        "type": "textbox",
        "hide": 0,
        "query": "",
        "current": {
          "text": "",
          "value": ""
        },
        "description": "Populated automatically when you click a row in the API REQUESTS table. You can also paste a trace ID here."
      },
      {
        "name": "min_duration",
        "label": "Trace min duration",
        "type": "custom",
        "hide": 0,
        "query": "0ms,10ms,50ms,100ms,250ms,500ms,1s,2s,5s",
        "options": [
          {
            "selected": true,
            "text": "0ms",
            "value": "0ms"
          },
          {
            "selected": false,
            "text": "10ms",
            "value": "10ms"
          },
          {
            "selected": false,
            "text": "50ms",
            "value": "50ms"
          },
          {
            "selected": false,
            "text": "100ms",
            "value": "100ms"
          },
          {
            "selected": false,
            "text": "250ms",
            "value": "250ms"
          },
          {
            "selected": false,
            "text": "500ms",
            "value": "500ms"
          },
          {
            "selected": false,
            "text": "1s",
            "value": "1s"
          },
          {
            "selected": false,
            "text": "2s",
            "value": "2s"
          },
          {
            "selected": false,
            "text": "5s",
            "value": "5s"
          }
        ],
        "current": {
          "selected": true,
          "text": "0ms",
          "value": "0ms"
        }
      },
      {
        "name": "status_min",
        "label": "Trace min HTTP status",
        "type": "custom",
        "hide": 0,
        "query": "All : 0,4xx and 5xx only : 400,5xx only : 500",
        "options": [
          {
            "selected": true,
            "text": "All",
            "value": "0"
          },
          {
            "selected": false,
            "text": "4xx and 5xx only",
            "value": "400"
          },
          {
            "selected": false,
            "text": "5xx only",
            "value": "500"
          }
        ],
        "current": {
          "selected": true,
          "text": "All",
          "value": "0"
        },
        "description": "TraceQL numeric floor on span.http.response.status_code. Display text vs substituted value: 'All' -> 0."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "DevopsLabs — Database / JDBC Connection Pool",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "transparent": true,
      "options": {
        "mode": "markdown",
        "content": "HikariCP connection pool health — used vs. idle, saturation, pending requests, and connection wait/use/create timing. For per-statement SQL latency, see the Slowest JDBC/SQL Spans panel in the Request Investigation dashboard."
      }
    },
    {
      "id": 701,
      "title": "Connection pool — used vs idle",
      "description": "Simple: How many database connections are actively in use versus sitting free.\n\ndb_client_connections_usage{state=\"used|idle\"} plus db_client_connections_max. v9 queried db_client_operation_duration_seconds_*, which the OTel Java agent does not emit for JDBC — that is why the DB panels were empty.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (pool_name, state) (db_client_connections_usage{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool_name}} {{state}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (pool_name) (db_client_connections_max{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool_name}} max"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": ".*max"
            },
            "properties": [
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "red"
                }
              },
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              },
              {
                "id": "custom.fillOpacity",
                "value": 0
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 702,
      "title": "Connection pool saturation",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "100 * sum by (pool_name) (db_client_connections_usage{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\",state=\"used\"}) / clamp_min(sum by (pool_name) (db_client_connections_max{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}), 1)",
          "range": true,
          "instant": false,
          "legendFormat": "{{pool_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "max": 100,
          "min": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "thresholdsStyle": {
              "mode": "dashed"
            },
            "spanNulls": true,
            "insertNulls": false
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 70
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Simple: How close the database connection pool is to running out of free connections."
    },
    {
      "id": 703,
      "title": "Pending connection requests",
      "description": "Simple: Requests currently waiting in line for a free database connection — should normally be zero.\n\nAnything above zero on 'pending' means threads are blocked waiting for a JDBC connection — the classic cause of a fast SQL query inside a slow HTTP request. NOTE: db_client_connections_timeouts_total is not emitted by your OTel Java agent build (verified against the Prometheus label API on 2026-08-11), so there is no pool-timeout series to chart; a sustained pending count is the signal to watch instead.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 3,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum by (pool_name) (db_client_connections_pending_requests{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "pending {{pool_name}}"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "range": true,
          "instant": false,
          "legendFormat": "idle floor {{pool_name}}",
          "expr": "sum by (pool_name) (db_client_connections_idle_min{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 704,
      "title": "Connection WAIT time (P50 / P95 / P99)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.50, sum by (le, pool_name) (rate(db_client_connections_wait_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P50 {{pool_name}}",
          "interval": "10m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, pool_name) (rate(db_client_connections_wait_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P95 {{pool_name}}",
          "interval": "10m"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, pool_name) (rate(db_client_connections_wait_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P99 {{pool_name}}",
          "interval": "10m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Simple: How long requests wait to get a database connection before they can even start work."
    },
    {
      "id": 705,
      "title": "Connection USE time (P95 / P99)",
      "description": "Simple: How long a database connection is held once a request has one.\n\nHow long a borrowed connection is held — the closest Prometheus-side proxy for query duration. Per-statement SQL timing lives in the Tempo JDBC spans panel above.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 10,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, pool_name) (rate(db_client_connections_use_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P95 {{pool_name}}",
          "interval": "10m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "histogram_quantile(0.99, sum by (le, pool_name) (rate(db_client_connections_use_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "P99 {{pool_name}}",
          "interval": "10m"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "sum by (pool_name) (rate(db_client_connections_use_time_milliseconds_sum{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])) / sum by (pool_name) (rate(db_client_connections_use_time_milliseconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "Avg {{pool_name}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 706,
      "title": "Connection CREATE time + borrow rate",
      "description": "Simple: How long it takes to open a brand-new database connection, and how often the app has to ask for one.\n\nA rising create time or a high borrow rate with a saturated pool points at pool sizing rather than at the query.",
      "type": "timeseries",
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, pool_name) (rate(db_client_connections_create_time_milliseconds_bucket{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval])))",
          "range": true,
          "instant": false,
          "legendFormat": "create P95 {{pool_name}}",
          "interval": "10m"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (pool_name) (rate(db_client_connections_use_time_milliseconds_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"}[$__rate_interval]))",
          "range": true,
          "instant": false,
          "legendFormat": "borrows/s {{pool_name}}",
          "interval": "2m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "decimals": 2,
          "custom": {
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byRegexp",
              "options": "borrows.*"
            },
            "properties": [
              {
                "id": "unit",
                "value": "ops"
              },
              {
                "id": "custom.axisPlacement",
                "value": "right"
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    }
  ]
