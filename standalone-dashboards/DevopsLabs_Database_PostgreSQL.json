          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 136 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "pg_replication_lag{database=~\"$database\"}", "legendFormat": "lag — {{database}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "bytes", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 1048576 }, { "color": "red", "value": 104857600 }] }, "custom": { "fillOpacity": 10 } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "id": 121,
          "type": "stat",
