    },

    {
      "id": 900,
      "type": "row",
      "title": "🧹 Vacuum & Autovacuum",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 84 },
      "collapsed": true,
      "panels": [
        {
          "id": 80,
          "type": "timeseries",
          "title": "Dead Tuples (Live vs Dead)",
          "description": "Dead tuples waiting for VACUUM. High counts mean autovacuum is lagging.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 85 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "topk(20, pg_stat_user_tables_n_dead_tup{database=~\"$database\"})", "legendFormat": "dead — {{database}}/{{relname}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 10 } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "id": 81,
          "type": "timeseries",
          "title": "Dead Tuple Ratio (Dead / Live+Dead)",
          "description": "Tables with dead tuple ratio > 20% urgently need vacuuming.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 85 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "topk(10, pg_stat_user_tables_n_dead_tup{database=~\"$database\"} / clamp_min(pg_stat_user_tables_n_dead_tup{database=~\"$database\"} + pg_stat_user_tables_n_live_tup{database=~\"$database\"}, 1))", "legendFormat": "{{database}}/{{relname}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.1 }, { "color": "red", "value": 0.2 }] }, "custom": { "fillOpacity": 10 } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "id": 82,
          "type": "timeseries",
          "title": "Last Autovacuum Ago (seconds)",
          "description": "Time since last autovacuum per table. Very high values indicate autovacuum is not reaching the table.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 93 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "topk(10, time() - pg_stat_user_tables_last_autovacuum{database=~\"$database\"} != 0)", "legendFormat": "{{database}}/{{relname}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "s", "decimals": 0, "custom": { "fillOpacity": 5 } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "id": 83,
          "type": "timeseries",
          "title": "Last Autoanalyze Ago (seconds)",
          "description": "Time since last autoanalyze. Stale statistics lead to poor query plans.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 93 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "topk(10, time() - pg_stat_user_tables_last_autoanalyze{database=~\"$database\"} != 0)", "legendFormat": "{{database}}/{{relname}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "s", "decimals": 0, "custom": { "fillOpacity": 5 } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        }
      ]
    },

    {
      "id": 1000,
      "type": "row",
      "title": "📇 Table & Index I/O",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 101 },
      "collapsed": true,
      "panels": [
        {
          "id": 90,
          "type": "timeseries",
          "title": "Table Seq Scan vs Index Scan (Rate)",
          "description": "Sequential scans are expensive on large tables. A healthy system should favor index scans.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 102 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "sum by (database) (rate(pg_stat_user_tables_seq_scan{database=~\"$database\"}[5m]))", "legendFormat": "seq_scan — {{database}}", "refId": "A" },
            { "expr": "sum by (database) (rate(pg_stat_user_tables_idx_scan{database=~\"$database\"}[5m]))", "legendFormat": "idx_scan — {{database}}", "refId": "B" }
          ],
          "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "/seq_scan/" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "id": 91,
          "type": "timeseries",
          "title": "Index Hit Ratio",
          "description": "Percentage of index reads served from cache. Target: >99%.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 102 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "100 * sum by (database) (rate(pg_statio_user_indexes_idx_blks_hit{database=~\"$database\"}[5m])) / clamp_min(sum by (database) (rate(pg_statio_user_indexes_idx_blks_hit{database=~\"$database\"}[5m]) + rate(pg_statio_user_indexes_idx_blks_read{database=~\"$database\"}[5m])), 1)", "legendFormat": "{{database}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "id": 92,
          "type": "timeseries",
          "title": "Table Bloat Estimation (Live vs Dead Rows)",
          "description": "Aggregate live and dead row counts per database — indicates table bloat.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 110 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "sum by (database) (pg_stat_user_tables_n_live_tup{database=~\"$database\"})", "legendFormat": "live — {{database}}", "refId": "A" },
            { "expr": "sum by (database) (pg_stat_user_tables_n_dead_tup{database=~\"$database\"})", "legendFormat": "dead — {{database}}", "refId": "B" }
          ],
          "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 15 } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "/dead/" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "id": 93,
          "type": "timeseries",
          "title": "Table I/O — Heap Blocks Hit vs Read",
          "description": "Rate of table heap blocks read from disk vs served from cache.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 110 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "sum by (database) (rate(pg_statio_user_tables_heap_blks_hit{database=~\"$database\"}[5m]))", "legendFormat": "heap hit — {{database}}", "refId": "A" },
            { "expr": "sum by (database) (rate(pg_statio_user_tables_heap_blks_read{database=~\"$database\"}[5m]))", "legendFormat": "heap read — {{database}}", "refId": "B" }
          ],
          "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "/heap read/" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        }
      ]
    },

    {
      "id": 1100,
      "type": "row",
      "title": "✏️ WAL & Checkpoints",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 118 },
      "collapsed": true,
      "panels": [
        {
          "id": 110,
          "type": "timeseries",
          "title": "Checkpoints — Timed vs Requested",
          "description": "Timed = scheduled checkpoints. Requested = forced by WAL filling up. High 'requested' = increase checkpoint_segments/max_wal_size.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 119 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "rate(pg_stat_bgwriter_checkpoints_timed{database=~\"$database\"}[5m])", "legendFormat": "timed — {{database}}", "refId": "A" },
            { "expr": "rate(pg_stat_bgwriter_checkpoints_req{database=~\"$database\"}[5m])", "legendFormat": "requested — {{database}}", "refId": "B" }
          ],
          "fieldConfig": { "defaults": { "unit": "ops", "decimals": 4, "custom": { "fillOpacity": 10 } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "/requested/" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "id": 111,
          "type": "timeseries",
          "title": "Checkpoint Write & Sync Time",
          "description": "Time spent writing and syncing during checkpoints. Spikes indicate I/O pressure.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 119 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "rate(pg_stat_bgwriter_checkpoint_write_time{database=~\"$database\"}[5m])", "legendFormat": "write time — {{database}}", "refId": "A" },
            { "expr": "rate(pg_stat_bgwriter_checkpoint_sync_time{database=~\"$database\"}[5m])", "legendFormat": "sync time — {{database}}", "refId": "B" }
          ],
          "fieldConfig": { "defaults": { "unit": "ms", "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "id": 112,
          "type": "timeseries",
          "title": "BGWriter — Buffers Written",
          "description": "Buffers written by bgwriter (background), backend (direct), and checkpoint.",
          "gridPos": { "h": 8, "w": 12, "x": 0, "y": 127 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "rate(pg_stat_bgwriter_buffers_checkpoint{database=~\"$database\"}[5m])", "legendFormat": "checkpoint — {{database}}", "refId": "A" },
            { "expr": "rate(pg_stat_bgwriter_buffers_clean{database=~\"$database\"}[5m])", "legendFormat": "bgwriter clean — {{database}}", "refId": "B" },
            { "expr": "rate(pg_stat_bgwriter_buffers_backend{database=~\"$database\"}[5m])", "legendFormat": "backend direct — {{database}}", "refId": "C" }
          ],
          "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "/backend direct/" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        },
        {
          "id": 113,
          "type": "timeseries",
          "title": "Backend Fsync Requests",
          "description": "Backends forced to do their own fsync. Should be 0. Non-zero = bgwriter can't keep up.",
          "gridPos": { "h": 8, "w": 12, "x": 12, "y": 127 },
          "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
          "targets": [
            { "expr": "rate(pg_stat_bgwriter_buffers_backend_fsync{database=~\"$database\"}[5m])", "legendFormat": "{{database}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "ops", "decimals": 4, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.001 }] }, "custom": { "fillOpacity": 10 } }, "overrides": [] },
          "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
        }
      ]
    },

    {
      "id": 1200,
      "type": "row",
      "title": "🔄 Replication",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 135 },
