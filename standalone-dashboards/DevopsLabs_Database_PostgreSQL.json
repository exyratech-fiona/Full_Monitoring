      "targets": [
        { "expr": "rate(pg_stat_database_conflicts{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m])", "legendFormat": "{{database}}/{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 4, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
