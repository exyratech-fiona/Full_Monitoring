      "title": "Database Size Growth Over Time",
      "description": "Track database size changes to predict storage needs.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 76 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "pg_database_size_bytes{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}", "legendFormat": "{{database}}/{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes", "custom": { "fillOpacity": 15 } }, "overrides": [] },
