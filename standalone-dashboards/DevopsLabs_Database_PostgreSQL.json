{
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "11.0.0"
    }
  ],
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": { "type": "grafana", "uid": "-- Grafana --" },
        "enable": true,
        "hide": true,
        "iconColor": "rgba(0, 211, 255, 1)",
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "description": "Comprehensive PostgreSQL monitoring dashboard powered by postgres_exporter v0.16. Covers availability, connections, transactions, cache, tuples, table/index I/O, vacuum, WAL, replication, database size, temp files, deadlocks, locks, checkpoints, and bgwriter stats.",
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "liveNow": false,
  "refresh": "1m",
  "schemaVersion": 39,
  "style": "dark",
  "tags": ["sre", "database", "postgresql", "postgres-exporter", "devopslabs"],
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {
    "refresh_intervals": ["10s", "30s", "1m", "5m", "15m", "1h"]
  },
  "timezone": "browser",
  "title": "DevopsLabs — PostgreSQL Database Health",
  "uid": "devopslabs-postgresql-database",
  "version": 2,
  "templating": {
    "list": [
      {
        "name": "prometheus_datasource",
        "label": "Metrics DS",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0
      },
      {
        "name": "database",
        "label": "Database Instance",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
        "definition": "label_values(pg_up, database)",
        "query": { "query": "label_values(pg_up, database)", "refId": "StandardVariableQuery" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": { "text": "All", "value": ["$__all"] },
        "hide": 0
      },
      {
        "name": "datname",
        "label": "DB Name",
        "type": "query",
        "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
        "definition": "label_values(pg_stat_database_numbackends{database=~\"$database\"}, datname)",
        "query": { "query": "label_values(pg_stat_database_numbackends{database=~\"$database\"}, datname)", "refId": "StandardVariableQuery" },
        "includeAll": true,
        "multi": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "regex": "/^(?!template[01]$).*/",
        "current": { "text": "All", "value": ["$__all"] },
        "hide": 0
      }
    ]
  },
  "panels": [

    {
      "id": 100,
      "type": "row",
      "title": "🔴 Overview & Availability",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false,
      "panels": []
    },

    {
      "id": 1,
      "type": "stat",
      "title": "Exporter Up",
      "description": "1 = exporter connected to PostgreSQL, 0 = connection failed.",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "pg_up{database=~\"$database\"}", "legendFormat": "{{database}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0, "max": 1,
          "mappings": [
            { "type": "value", "options": { "0": { "text": "DOWN", "color": "red" }, "1": { "text": "UP", "color": "green" } } }
          ],
          "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "green", "value": 1 }] }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "textMode": "auto" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "PostgreSQL Version",
      "description": "PostgreSQL server version reported by the exporter.",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "pg_static{database=~\"$database\"}", "legendFormat": "{{database}} — v{{short_version}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "none" }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "none", "textMode": "name" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Total Active Connections",
      "description": "Sum of all active backend connections across selected databases.",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "sum by (database) (pg_stat_database_numbackends{datname!=\"\",database=~\"$database\",datname=~\"$datname\"})", "legendFormat": "{{database}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 0, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 150 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "background", "textMode": "auto" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Max Connections Setting",
      "description": "The PostgreSQL max_connections setting.",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "pg_settings_max_connections{database=~\"$database\"}", "legendFormat": "{{database}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "none", "textMode": "auto" }
    },
    {
      "id": 5,
      "type": "gauge",
      "title": "Connection Usage %",
      "description": "Percentage of max_connections currently in use.",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "100 * sum by (database) (pg_stat_database_numbackends{datname!=\"\",database=~\"$database\"}) / on (database) pg_settings_max_connections{database=~\"$database\"}", "legendFormat": "{{database}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 1, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "yellow", "value": 60 }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] } },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "showThresholdLabels": false, "showThresholdMarkers": true }
    },
    {
      "id": 6,
      "type": "stat",
      "title": "Uptime",
      "description": "Time since the PostgreSQL server was started.",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "time() - pg_postmaster_start_time_seconds{database=~\"$database\"}", "legendFormat": "{{database}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 0 }, "overrides": [] },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "auto", "colorMode": "none", "textMode": "auto" }
    },

    {
      "id": 200,
      "type": "row",
      "title": "🔗 Connections",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false,
      "panels": []
    },

    {
      "id": 10,
      "type": "timeseries",
      "title": "Active Connections Over Time",
      "description": "Number of active backends per database over time.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "pg_stat_database_numbackends{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}", "legendFormat": "{{database}} / {{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 15 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Connection Usage % Over Time",
      "description": "Percentage of max_connections in use. Alert if consistently above 80%.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "100 * sum by (database) (pg_stat_database_numbackends{datname!=\"\",database=~\"$database\"}) / on (database) pg_settings_max_connections{database=~\"$database\"}", "legendFormat": "{{database}}", "refId": "A" }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent", "min": 0, "max": 100,
          "custom": { "fillOpacity": 10 },
          "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 70 }, { "color": "red", "value": 90 }] }
        },
        "overrides": []
      },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    {
      "id": 300,
      "type": "row",
      "title": "📊 Transactions",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false,
      "panels": []
    },

    {
      "id": 20,
      "type": "timeseries",
      "title": "Transactions Per Second (Commit vs Rollback)",
      "description": "Rate of committed and rolled-back transactions.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "sum by (database, datname) (rate(pg_stat_database_xact_commit{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]))", "legendFormat": "commit — {{database}}/{{datname}}", "refId": "A" },
        { "expr": "sum by (database, datname) (rate(pg_stat_database_xact_rollback{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]))", "legendFormat": "rollback — {{database}}/{{datname}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "/rollback/" }, "properties": [{ "id": "custom.drawStyle", "value": "bars" }, { "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 21,
      "type": "timeseries",
      "title": "Rollback Ratio %",
      "description": "Percentage of transactions that are rolled back. High values indicate application errors.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "100 * rate(pg_stat_database_xact_rollback{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]) / clamp_min(rate(pg_stat_database_xact_commit{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]) + rate(pg_stat_database_xact_rollback{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]), 0.001)", "legendFormat": "{{database}}/{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 5 }, { "color": "red", "value": 25 }] }, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    {
      "id": 400,
      "type": "row",
      "title": "💾 Cache & Buffer Performance",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false,
      "panels": []
    },

    {
      "id": 30,
      "type": "timeseries",
      "title": "Cache Hit Ratio %",
      "description": "Percentage of data reads served from shared_buffers cache. Target: >99% for OLTP workloads.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "100 * sum by (database, datname) (rate(pg_stat_database_blks_hit{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m])) / clamp_min(sum by (database, datname) (rate(pg_stat_database_blks_hit{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]) + rate(pg_stat_database_blks_read{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m])), 1)", "legendFormat": "{{database}}/{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "decimals": 2, "thresholds": { "mode": "absolute", "steps": [{ "color": "red", "value": null }, { "color": "orange", "value": 90 }, { "color": "green", "value": 99 }] }, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 31,
      "type": "timeseries",
      "title": "Blocks Read vs Hit (Rate)",
      "description": "Rate of blocks read from disk vs served from cache. High disk reads = poor cache performance.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "sum by (database, datname) (rate(pg_stat_database_blks_hit{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]))", "legendFormat": "cache hit — {{database}}/{{datname}}", "refId": "A" },
        { "expr": "sum by (database, datname) (rate(pg_stat_database_blks_read{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]))", "legendFormat": "disk read — {{database}}/{{datname}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [{ "matcher": { "id": "byRegexp", "options": "/disk read/" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    {
      "id": 500,
      "type": "row",
      "title": "📝 Tuple (Row) Operations",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false,
      "panels": []
    },

    {
      "id": 40,
      "type": "timeseries",
      "title": "Rows Returned vs Fetched (Rate)",
      "description": "Returned = rows scanned by queries. Fetched = rows actually used. A big gap means inefficient queries.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "sum by (database, datname) (rate(pg_stat_database_tup_returned{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]))", "legendFormat": "returned — {{database}}/{{datname}}", "refId": "A" },
        { "expr": "sum by (database, datname) (rate(pg_stat_database_tup_fetched{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]))", "legendFormat": "fetched — {{database}}/{{datname}}", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 41,
      "type": "timeseries",
      "title": "Rows Inserted / Updated / Deleted (Rate)",
      "description": "Rate of DML operations (INSERT, UPDATE, DELETE) per database.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 33 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "sum by (database, datname) (rate(pg_stat_database_tup_inserted{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]))", "legendFormat": "inserted — {{database}}/{{datname}}", "refId": "A" },
        { "expr": "sum by (database, datname) (rate(pg_stat_database_tup_updated{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]))", "legendFormat": "updated — {{database}}/{{datname}}", "refId": "B" },
        { "expr": "sum by (database, datname) (rate(pg_stat_database_tup_deleted{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m]))", "legendFormat": "deleted — {{database}}/{{datname}}", "refId": "C" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 42,
      "type": "timeseries",
      "title": "Fetch Efficiency (Fetched / Returned)",
      "description": "Ratio of rows actually used vs scanned. Values close to 1 = efficient queries. Low values = seq scans or missing indexes.",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 41 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "sum by (database, datname) (rate(pg_stat_database_tup_fetched{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m])) / clamp_min(sum by (database, datname) (rate(pg_stat_database_tup_returned{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m])), 0.001)", "legendFormat": "{{database}}/{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1, "decimals": 3, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "min"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    {
      "id": 600,
      "type": "row",
      "title": "🔒 Locks & Deadlocks",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 49 },
      "collapsed": false,
      "panels": []
    },

    {
      "id": 50,
      "type": "timeseries",
      "title": "Lock Count by Mode",
      "description": "Active locks grouped by lock mode (AccessShare, RowExclusive, etc.).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "sum by (database, datname, mode) (pg_locks_count{datname!=\"\",database=~\"$database\",datname=~\"$datname\"})", "legendFormat": "{{mode}} — {{database}}/{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0, "custom": { "fillOpacity": 15, "stacking": { "mode": "normal" } } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 51,
      "type": "timeseries",
      "title": "Deadlocks (Rate)",
      "description": "Rate of deadlocks detected. Any value above 0 needs investigation.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 50 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "rate(pg_stat_database_deadlocks{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m])", "legendFormat": "{{database}}/{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 4, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "red", "value": 0.001 }] }, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },

    {
      "id": 700,
      "type": "row",
      "title": "📁 Temp Files & Conflicts",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 58 },
      "collapsed": false,
      "panels": []
    },

    {
      "id": 60,
      "type": "timeseries",
      "title": "Temp Files Created (Rate)",
      "description": "Rate of temp files created by queries that exceed work_mem. High values = increase work_mem or optimize queries.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 59 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "rate(pg_stat_database_temp_files{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m])", "legendFormat": "{{database}}/{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "ops", "decimals": 4, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 0.01 }, { "color": "red", "value": 0.1 }] }, "custom": { "fillOpacity": 10 } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } }
    },
    {
      "id": 61,
      "type": "timeseries",
      "title": "Temp Bytes Written (Rate)",
      "description": "Bytes written to temp files per second. Large values indicate sort/hash spills to disk.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 59 },
      "datasource": { "type": "prometheus", "uid": "${prometheus_datasource}" },
      "targets": [
        { "expr": "rate(pg_stat_database_temp_bytes{datname!=\"\",database=~\"$database\",datname=~\"$datname\"}[5m])", "legendFormat": "{{database}}/{{datname}}", "refId": "A" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps", "decimals": 2, "custom": { "fillOpacity": 10 } }, "overrides": [] },
