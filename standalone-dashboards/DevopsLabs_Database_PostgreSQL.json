          "targets": [
            { "expr": "pg_replication_slots_active{database=~\"$database\"}", "legendFormat": "{{slot_name}} — {{database}}", "refId": "A" }
          ],
          "fieldConfig": { "defaults": { "unit": "short", "mappings": [{ "type": "value", "options": { "0": { "text": "INACTIVE", "color": "red" }, "1": { "text": "ACTIVE", "color": "green" } } }] }, "overrides": [] },
          "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "textMode": "auto" }
        }
      ]
    },

