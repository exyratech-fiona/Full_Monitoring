    {
      "id": 807,
      "title": "JVM threads — live / by state / peak",
      "description": "Simple: How many worker threads the app has running, and whether they're busy, waiting, or idle.\n\nOTel's JVM instrumentation does not emit a peak-threads gauge (that is a Micrometer metric). 'peak (observed)' below is max_over_time() across the selected range, which is the honest equivalent from OTel data.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 17,
        "w": 8,
        "h": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${prometheus_datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "editorMode": "code",
          "expr": "sum (jvm_thread_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "live threads"
        },
        {
          "refId": "B",
          "editorMode": "code",
          "expr": "sum by (jvm_thread_state) (jvm_thread_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})",
          "range": true,
          "instant": false,
          "legendFormat": "{{jvm_thread_state}}"
        },
        {
          "refId": "C",
          "editorMode": "code",
          "expr": "max_over_time(sum(jvm_thread_count{service_name=~\"$service_name\",deployment_environment=~\"$deployment_environment\",k8s_namespace_name=~\"$service_namespace\"})[$__range:1m])",
          "range": true,
          "instant": false,
          "legendFormat": "peak (observed)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
            "spanNulls": true,
            "insertNulls": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "peak (observed)"
            },
            "properties": [
              {
                "id": "custom.lineStyle",
                "value": {
                  "fill": "dash",
                  "dash": [
                    8,
                    6
                  ]
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "live threads"
            },
            "properties": [
              {
                "id": "custom.lineWidth",
                "value": 3
              }
            ]
          }
        ]
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
